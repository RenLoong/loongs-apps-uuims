{
  "package": "loongs/uuims",
  "name": "UUIMS",
  "description": "统一用户身份管理系统（账号、角色、权限、OAuth、消息）",
  "icon": "",
  "version": "1.0.0",
  "version_name": "正式版",
  "services": [
    {
      "id": "menus",
      "role": "main"
    }
  ],
  "comment": "UUIMS app menus, pages and buttons (permission codes). Merged with apps/*/loongs.json of every other app; see README §3.",
  "menus": [
    {
      "id": "main",
      "list": [
        {
          "type": "menu",
          "name": "首页",
          "path": "/dashboard",
          "icon": "layout-dashboard",
          "perms": "dashboard:overview",
          "sort": 0,
          "page": "uuims.dashboard.overview",
          "page_type": "dashboard",
          "children": [
            {
              "type": "page",
              "name": "租户详情（样例）",
              "page": "uuims.sample.tenant-detail",
              "page_type": "detail"
            },
            {
              "type": "page",
              "name": "租户套餐记录（样例）",
              "page": "uuims.sample.tenant-plan-logs",
              "page_type": "table"
            },
            {
              "type": "page",
              "name": "租户状态（样例）",
              "page": "uuims.sample.tenants",
              "page_type": "table"
            }
          ]
        },
        {
          "type": "dir",
          "name": "系统管理",
          "path": "/system",
          "icon": "settings",
          "sort": 10000,
          "children": [
            {
              "type": "menu",
              "name": "管理员",
              "path": "/system/users",
              "component": "system/users",
              "perms": "system:uuims:list",
              "sort": 1,
              "page": "uuims.system.users",
              "page_type": "table",
              "children": [
                {
                  "type": "page",
                  "name": "管理员表单",
                  "page": "uuims.system.uuims-form",
                  "page_type": "form"
                },
                {
                  "type": "page",
                  "name": "重置密码",
                  "page": "uuims.system.uuims-password",
                  "page_type": "form"
                },
                {
                  "type": "button",
                  "name": "新增",
                  "perms": "system:uuims:create"
                },
                {
                  "type": "button",
                  "name": "编辑",
                  "perms": "system:uuims:update"
                },
                {
                  "type": "button",
                  "name": "删除",
                  "perms": "system:uuims:delete"
                },
                {
                  "type": "button",
                  "name": "重置密码",
                  "perms": "system:uuims:reset-password"
                },
                {
                  "type": "button",
                  "name": "解绑微信",
                  "perms": "system:uuims:unbind-wechat"
                }
              ]
            },
            {
              "type": "menu",
              "name": "角色",
              "path": "/system/roles",
              "component": "system/roles",
              "perms": "system:role:list",
              "sort": 2,
              "page": "uuims.system.roles",
              "page_type": "table",
              "children": [
                {
                  "type": "page",
                  "name": "角色表单",
                  "page": "uuims.system.role-form",
                  "page_type": "form"
                },
                {
                  "type": "page",
                  "name": "角色权限",
                  "page": "uuims.system.role-permissions",
                  "page_type": "custom"
                },
                {
                  "type": "button",
                  "name": "新增",
                  "perms": "system:role:create"
                },
                {
                  "type": "button",
                  "name": "编辑",
                  "perms": "system:role:update"
                },
                {
                  "type": "button",
                  "name": "删除",
                  "perms": "system:role:delete"
                }
              ]
            },
            {
              "type": "menu",
              "name": "菜单",
              "path": "/system/menus",
              "component": "system/menus",
              "perms": "system:menu:list",
              "sort": 3,
              "page": "uuims.system.menus",
              "page_type": "table"
            },
            {
              "type": "menu",
              "name": "部门",
              "path": "/system/depts",
              "component": "system/depts",
              "perms": "system:dept:list",
              "sort": 4,
              "page": "uuims.system.depts",
              "page_type": "table",
              "children": [
                {
                  "type": "page",
                  "name": "部门表单",
                  "page": "uuims.system.dept-form",
                  "page_type": "form"
                },
                {
                  "type": "button",
                  "name": "新增",
                  "perms": "system:dept:create"
                },
                {
                  "type": "button",
                  "name": "编辑",
                  "perms": "system:dept:update"
                },
                {
                  "type": "button",
                  "name": "删除",
                  "perms": "system:dept:delete"
                }
              ]
            }
          ]
        },
        {
          "type": "menu",
          "name": "消息",
          "path": "/messages",
          "icon": "bell",
          "perms": "message:list",
          "sort": 200,
          "page": "uuims.message.inbox",
          "page_type": "table",
          "children": [
            {
              "type": "page",
              "name": "消息详情",
              "page": "uuims.message.detail",
              "page_type": "detail"
            },
            {
              "type": "page",
              "name": "发送消息",
              "page": "uuims.message.send-form",
              "page_type": "form"
            },
            {
              "type": "button",
              "name": "发送",
              "perms": "message:send"
            }
          ]
        }
      ]
    }
  ]
}
